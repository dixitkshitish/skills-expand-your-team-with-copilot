},\n    \"scenario_4_teacher_schedules\": {\n      \"title\": \"Create Teacher Schedule API\",\n      \"user_request\": \"Build an API for managing teacher schedules with fields: teacher_id, day_of_week, start_time, end_time, activity_id, location.\",\n      \"script_command\": [\n        \"python\",\n        \".github/skills/fastapi-route-scaffolding/scripts/route_scaffolder.py\",\n        \"--name\", \"teacher_schedules\",\n        \"--fields\", \"teacher_id:str,day_of_week:str,start_time:str,end_time:str,activity_id:str,location:str\"\n      ],\n      \"generated_files\": [\n        \"src/backend/models/teacher_schedules.py\",\n        \"src/backend/repositories/teacher_schedules.py\",\n        \"src/backend/routers/teacher_schedules.py\",\n        \"tests/test_teacher_schedules.py\"\n      ],\n      \"files_to_update\": [\n        \"src/app.py\",\n        \"src/backend/database.py\"\n      ],\n      \"expected_endpoints\": [\n        \"GET /teacher_schedules - List all schedules\",\n        \"POST /teacher_schedules - Create new schedule\",\n        \"GET /teacher_schedules/{schedule_id} - Get schedule\",\n        \"PUT /teacher_schedules/{schedule_id} - Update schedule\",\n        \"DELETE /teacher_schedules/{schedule_id} - Delete schedule\",\n        \"GET /teacher_schedules/teacher/{teacher_id} - Get teacher's schedule\"\n      ],\n      \"customizations_needed\": [\n        \"Add day validation (Monday-Sunday)\",\n        \"Add time format validation (HH:MM)\",\n        \"Add conflict detection (overlapping schedules)\",\n        \"Add iCalendar export\",\n        \"Add teacher availability check\"\n      ],\n      \"estimated_lines_of_code\": 600\n    },\n    \"scenario_5_activity_signups\": {\n      \"title\": \"Create Activity Signup Management API\",\n      \"user_request\": \"Create an API for managing activity signups with student_id, activity_id, signup_date, and status (pending, approved, rejected, cancelled).\",\n      \"script_command\": [\n       