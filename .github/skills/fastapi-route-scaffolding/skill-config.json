  "field_types_supported": [
    "str",
    "int",
    "float",
    "bool",
    "list",
    "dict",
    "datetime",
    "date",
    "time"
  ],
  "generated_components": {
    "pydantic_models": {
      "description": "Validation models with Create, Update, and Response variants",
      "location": "src/backend/models/{module}.py",
      "includes": [
        "Field validation",
        "Type hints",
        "JSON schema examples",
        "Documentation"
      ]
    },
    "repository": {
      "description": "Data access layer with CRUD operations",
      "location": "src/backend/repositories/{module}.py",
      "includes": [
        "find_all() with pagination",
        "find_by_id()",
        "create()",
        "update()",
        "delete()",
        "count()",
        "MongoDB ObjectId handling",
        "Timestamp management"
      ]
    },
    "router": {
      "description": "FastAPI endpoints for the feature",
      "location": "src/backend/routers/{module}.py",
      "includes": [
        "GET / - list with pagination",
        "POST / - create",
        "GET /{id} - retrieve",
        "PUT /{id} - update",
        "DELETE /{id} - delete",
        "Error handling",
        "Status codes",
        "Route documentation"
      ]
    },
    "tests": {
      "description": "Unit test template",
      "location": "tests/test_{module}.py",
      "includes": [
        "Test list operation",
        "Test create operation",
        "Test read operation",
        "Test update operation",
        "Test delete operation",
        "FastAPI TestClient usage"
      ]
    },
    "integration_code": {
      "description": "Code snippets to integrate generated components",
      "updates": [
        "src/app.py - import and register router",
        "src/backend/database.py - collection initialization"
      ]
    }
  },
  "integration_steps": {
    "step_1": {
      "title": "Create Model File",
