    },
    "step_2": {
      "title": "Create Repository File",
      "action": "Create src/backend/repositories/{module}.py with generated code",
      "importance": "required"
    },
    "step_3": {
      "title": "Create Router File",
      "action": "Create src/backend/routers/{module}.py with generated code",
      "importance": "required"
    },
    "step_4": {
      "title": "Update Database Config",
      "action": "Add collection to src/backend/database.py",
      "importance": "required"
    },
    "step_5": {
      "title": "Update Main App",
      "action": "Import and register router in src/app.py",
      "importance": "required"
    },
    "step_6": {
      "title": "Create Tests",
      "action": "Create tests/test_{module}.py with test template",
