{
  "skill_metadata": {
    "name": "FastAPI Route and MongoDB Model Scaffolding",
    "version": "1.0.0",
    "id": "fastapi-route-scaffolding",
    "description": "Automatically generates FastAPI routes, Pydantic models, and MongoDB repositories for new API features",
    "author": "Mergington High School Development Team",
    "created": "2024-06-02",
    "updated": "2024-06-02",
    "status": "production"
  },
  "skill_configuration": {
    "trigger_keywords": [
      "create.*api.*route",
      "new.*endpoint",
      "add.*crud.*operation",
      "scaffold.*fastapi",
      "generate.*model",
      "create.*repository"
    ],
    "supported_operations": [
      "create",
      "read",
      "update",
      "delete",
      "list",
      "search",
      "filter",
      "paginate"
    ],
    "language": "python",
    "framework": "fastapi",
    "database": "mongodb",
    "script_path": ".github/skills/fastapi-route-scaffolding/scripts/route_scaffolder.py"
  },
  "example_scenarios": {
    "scenario_1_attendance_tracking": {
      "title": "Create Attendance Tracking API",
      "user_request": "Create an API for tracking student attendance at activities with fields for student_id, activity_id, attended status, date, and optional notes.",
      "script_command": [
        "python",
        ".github/skills/fastapi-route-scaffolding/scripts/route_scaffolder.py",
        "--name", "attendance",
        "--fields", "student_id:str,activity_id:str,attended:bool,date_assigned:str,notes:str"
      ],
      "generated_files": [
        "src/backend/models/attendance.py",
        "src/backend/repositories/attendance.py",
        "src/backend/routers/attendance.py",
        "tests/test_attendance.py"
      ],
      "files_to_update": [
        "src/app.py",
        "src/backend/database.py"
      ],
      "expected_endpoints": [
        "GET /attendance - List attendance records",
        "POST /attendance - Create new attendance record",
        "GET /attendance/{attendance_id} - Get single record",
        "PUT /attendance/{attendance_id} - Update record",
        "DELETE /attendance/{attendance_id} - Delete record"
      ],
      "estimated_lines_of_code": 450
    },
