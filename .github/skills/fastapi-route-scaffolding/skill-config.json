    },
    "step_7": {
      "title": "Add Validators",
      "action": "Add Pydantic validators for business logic",
      "importance": "recommended"
    },
    "step_8": {
      "title": "Add Permissions",
      "action": "Add authorization checks if needed",
      "importance": "optional"
    }
  },
